# Agenthood Studio — Environment Variables
# Copy this file to .env.local and fill in your keys.

# Required — used by the server-side adapter for chat requests.
# Powers the Studio's zero-setup default (OpenCode Zen), so visitors can chat
# without configuring anything:
OPENCODE_API_KEY=oc-...

# Optional — only used as fallbacks when OpenCode Zen is unreachable:
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Optional — self-hosted Ollama endpoint:
OLLAMA_HOST=http://localhost:11434

# Required for Cloudflare Turnstile CAPTCHA (playground chat, workspaces and Jev proxy):
# Get keys from https://dash.cloudflare.com -> Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# Set to "false" to disable CAPTCHA entirely (single source of truth for client + server):
# NEXT_PUBLIC_TURNSTILE_ENABLED="true"
# Default "true": when CAPTCHA is enabled but keys are missing, protected routes
# fail closed instead of silently accepting untrusted requests.
# TURNSTILE_REQUIRED="true"

# Optional — calibrated Jev routing for workspaces (server-only secret):
# JEV_ROUTING_ENABLED="false"
# JEV_INTERNAL_TOKEN=""

# Optional — Sentry error tracking:
# Get DSN from https://sentry.io -> Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Required in production — Upstash Redis for rate limiting + workspaces.
# Without it, rate limiting falls back to per-instance memory (bypassable
# across lambdas) and workspaces are lost on cold start/scale-to-zero.
# Provision via https://upstash.com (direct, no Vercel KV markup):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Optional — extra same-origin values for previews (comma-separated).
# VERCEL_URL is allowed automatically; production canonical stays
# https://agenthood.flabs.tech:
# ALLOWED_ORIGINS="https://staging.example.com"

# Optional — MCP remote servers (Agenthood 4.5, HTTP only on Vercel).
# Stdio is explicitly unsupported in serverless and fails closed.
# Servers are host-declared in .agenthood/config.json `mcpServers`, never in
# SKILL.md or client input; secrets only via env-substituted headers:
# MCP_DOCS_URL="https://..."
# MCP_DOCS_AUTH_TOKEN=""
