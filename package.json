{
  "name": "agenthood-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "sync": "node scripts/sync-docs.mjs",
    "sync-skills": "node scripts/sync-skills.mjs",
    "sync-news": "node scripts/build-news-manifest.mjs",
    "summarize-news": "node scripts/summarize-news.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "postinstall": "patch-package",
    "prebuild": "npm run sync && npm run sync-news && npm run sync-skills",
    "predev": "npm run sync && npm run sync-news -- --lenient && npm run sync-skills"
  },
  "dependencies": {
    "@mantine/code-highlight": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@mantine/nprogress": "^9.6.0",
    "@mantine/spotlight": "^9.6.0",
    "@sentry/nextjs": "^10.73.0",
    "@tabler/icons-react": "^3.46.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "agenthood": "3.56.6",
    "js-yaml": "^5.4.1",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwind-preset-mantine": "^4.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
